---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const patologie = await getCollection('patologie');
  return patologie.map(p => ({
    params: { slug: p.slug },
    props: { patologia: p },
  }));
}

interface Props { patologia: CollectionEntry<'patologie'>; }
const { patologia } = Astro.props;
const { Content } = await patologia.render();
const categoria = patologia.data.categoria === 'anca' ? "dell'anca" : "del ginocchio";
---
<BaseLayout title={patologia.data.title} description={patologia.data.description}>

  <section class="article-hero">
    <div class="container">
      <p class="article-eyebrow">Patologie {categoria}</p>
      <h1>{patologia.data.title}</h1>
      <p class="lead">{patologia.data.description}</p>
    </div>
  </section>

  <section class="article-body">
    <div class="container">
      <div class="article-content">
        <Content />
        <div class="article-cta-box">
          <h3>Hai bisogno di una valutazione?</h3>
          <p>Il Dott. Rivera riceve presso l'Ospedale Cottolengo di Torino. È possibile prenotare una visita specialistica per una valutazione approfondita della sua condizione.</p>
          <a href="/prenota" class="btn-primary">Prenota una visita</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
