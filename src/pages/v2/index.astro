---
import BaseLayoutV2 from '../../layouts/BaseLayoutV2.astro';
---

<BaseLayoutV2 title="Specialista in Ortopedia e Traumatologia - Versione 2">

<!-- HERO -->
<div class="hero">
  <div class="hero-content">
    <div class="hero-accent">✨ Eccellenza in Ortopedia</div>
    <h1>Dott. Fabrizio Rivera</h1>
    <p class="role">Ortopedia e Traumatologia · Torino</p>
    <p class="subtitle">Direttore S.C. Ortopedia, Ospedale Cottolengo<br/>Specialista in chirurgia protesica di anca e ginocchio</p>
    <div class="hero-cta">
      <button class="btn btn-primary">Prenota una visita</button>
      <button class="btn btn-secondary">Chi sono</button>
    </div>
  </div>
</div>

<!-- PATOLOGIE ANCA -->
<div class="parallax-section" style="background: #FAFBFC;">
  <div class="parallax-bg" style="background: linear-gradient(180deg, rgba(3, 105, 161, 0.03) 0%, transparent 100%);"></div>
  <div class="section">
    <div class="section-header">
      <h2>Patologie dell'anca</h2>
      <p>Soluzioni chirurgiche avanzate con risultati clinici eccellenti</p>
    </div>

    <div class="cards-container">
      <div class="card">
        <div class="card-icon">🦴</div>
        <div class="card-body">
          <div class="card-label">Anca</div>
          <h3>La protesi d'anca</h3>
          <p>Soluzione definitiva per la degenerazione articolare con risultati eccellenti in mobilità e qualità della vita.</p>
          <div class="card-arrow">Scopri di più →</div>
        </div>
      </div>

      <div class="card">
        <div class="card-icon">⚡</div>
        <div class="card-body">
          <div class="card-label">Anca</div>
          <h3>Conflitto femoro-acetabolare</h3>
          <p>Patologia causa di artrosi precoce nei pazienti giovani, trattabile con chirurgia mini-invasiva.</p>
          <div class="card-arrow">Scopri di più →</div>
        </div>
      </div>

      <div class="card">
        <div class="card-icon">💪</div>
        <div class="card-body">
          <div class="card-label">Anca</div>
          <h3>Artrosi dell'anca</h3>
          <p>Percorso terapeutico personalizzato dalle terapie conservative alla chirurgia protesica.</p>
          <div class="card-arrow">Scopri di più →</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- PATOLOGIE GINOCCHIO -->
<div class="parallax-section" style="background: white;">
  <div class="parallax-bg" style="background: linear-gradient(180deg, transparent 0%, rgba(3, 105, 161, 0.02) 100%);"></div>
  <div class="section">
    <div class="section-header">
      <h2>Patologie del ginocchio</h2>
      <p>Trattamenti innovativi dall'artroscopia all'artroprotesi robotica</p>
    </div>

    <div class="cards-container">
      <div class="card">
        <div class="card-icon">🦵</div>
        <div class="card-body">
          <div class="card-label">Ginocchio</div>
          <h3>La gonartrosi</h3>
          <p>Artrosi del ginocchio con soluzioni per ogni stadio clinico, dalla conservativa alla protesi.</p>
          <div class="card-arrow">Scopri di più →</div>
        </div>
      </div>

      <div class="card">
        <div class="card-icon">🤖</div>
        <div class="card-body">
          <div class="card-label">Ginocchio</div>
          <h3>Artroprotesi con ROSA</h3>
          <p>Sostituzione articolare con sistema robotico per precisione millimetrica e risultati superiori.</p>
          <div class="card-arrow">Scopri di più →</div>
        </div>
      </div>

      <div class="card">
        <div class="card-icon">🔗</div>
        <div class="card-body">
          <div class="card-label">Ginocchio</div>
          <h3>Lesioni legamentose</h3>
          <p>Ricostruzione artroscopica dei legamenti con tecniche mininvasive e recupero rapido.</p>
          <div class="card-arrow">Scopri di più →</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- STATS + CHI SONO -->
<div class="parallax-section" style="background: #FAFBFC;">
  <div class="parallax-bg" style="background: linear-gradient(180deg, rgba(255, 122, 69, 0.02) 0%, transparent 100%);"></div>
  <div class="section">
    <div class="stats-grid">
      <div class="stat">
        <div class="stat-number">25+</div>
        <div class="stat-label">Anni di esperienza</div>
      </div>
      <div class="stat">
        <div class="stat-number">100+</div>
        <div class="stat-label">Pubblicazioni scientifiche</div>
      </div>
      <div class="stat">
        <div class="stat-number">5000+</div>
        <div class="stat-label">Interventi chirurgici</div>
      </div>
    </div>

    <div class="cta-section">
      <div class="divider"></div>
      <h2>Percorso fondato su ricerca e pratica clinica</h2>
      <p>Laureato con lode e specializzato con lode, ho dedicato oltre 25 anni alla chirurgia ortopedica con costante attenzione alla ricerca scientifica. Associate Editor del Journal of Orthopaedics and Traumatology, International Member dell'AAOS, autore di oltre 100 pubblicazioni.</p>
      <button class="btn btn-primary">Leggi il curriculum completo</button>
    </div>
  </div>
</div>

</BaseLayoutV2>