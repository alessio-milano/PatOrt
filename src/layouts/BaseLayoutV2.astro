---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Dott. Fabrizio Rivera — Specialista in Ortopedia e Traumatologia. Direttore S.C. Ortopedia, Ospedale Cottolengo, Torino." } = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Dott. Fabrizio Rivera — Ortopedia Torino</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@1,400;1,600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg viewBox='0 0 42 42' xmlns='http://www.w3.org/2000/svg'%3E%3Crect width='42' height='42' rx='9' fill='%230a1628'/%3E%3Cpath d='M 9 26 A 13 13 0 0 1 32.6 15.2' transform='rotate(-20 24 15.2)' fill='none' stroke='%233ECFBF' stroke-width='3.6' stroke-linecap='round'/%3E%3Ccircle cx='24' cy='15.2' r='5.2' fill='%23FFFFFF'/%3E%3Cpath d='M20.4 19.2C19.4 23.6 17.9 28 15.9 32.2C15.4 33.3 17.5 34 18.2 32.9C20.9 28.6 23.6 24 25.8 19.9C24.1 18.5 21.9 18.2 20.4 19.2Z' fill='%23FFFFFF'/%3E%3C/svg%3E" />
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { font-size: 16px; scroll-behavior: smooth; }
      body {
        font-family: 'Inter', system-ui, sans-serif;
        background: #F7F3EC;
        color: #1A1A1A;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .v2-container {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 clamp(1.25rem, 4vw, 2.5rem);
      }

      /* ===== HERO ===== */
      .v2-hero {
        background: linear-gradient(145deg, #0a1628 0%, #1a3a5c 100%);
        padding: clamp(3rem, 7vw, 5rem) 0 0;
      }

      .v2-hero-inner {
        display: grid;
        grid-template-columns: 60% 40%;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
        padding-bottom: clamp(2.5rem, 5vw, 4rem);
      }

      .v2-eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #E07840;
        font-size: 0.75rem;
        font-weight: 600;
        margin-bottom: 1.1rem;
      }

      .v2-hero-left h1 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 3.6rem;
        color: #FFFFFF;
        line-height: 1.08;
        letter-spacing: -0.01em;
        margin-bottom: 1.6rem;
      }

      .v2-credential {
        border-left: 3px solid #D4622E;
        padding-left: 1.2rem;
        margin-bottom: 2.2rem;
      }

      .v2-credential p {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.98rem;
        line-height: 1.7;
      }

      .v2-credential p strong {
        display: block;
        color: #FFFFFF;
        font-weight: 700;
        margin-bottom: 0.2rem;
      }

      .v2-hero-cta {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 2.4rem;
      }

      .v2-btn {
        display: inline-block;
        font-family: inherit;
        font-size: 0.95rem;
        padding: 0.85rem 2rem;
        border-radius: 4px;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        text-decoration: none;
      }

      .v2-btn-primary {
        background: #E07840;
        color: #FFFFFF;
        border: 1px solid #E07840;
      }

      .v2-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(224, 120, 64, 0.25);
      }

      .v2-btn-secondary {
        background: transparent;
        color: #FFFFFF;
        border: 1px solid rgba(255, 255, 255, 0.3);
      }

      .v2-btn-secondary:hover {
        border-color: rgba(255, 255, 255, 0.6);
      }

      .v2-quote {
        background: rgba(255, 255, 255, 0.05);
        border-left: 3px solid #E07840;
        border-radius: 0 4px 4px 0;
        padding: 1.2rem 1.5rem;
      }

      .v2-quote p {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-style: italic;
        font-size: 1.15rem;
        color: rgba(255, 255, 255, 0.85);
        line-height: 1.6;
        margin-bottom: 0.6rem;
      }

      .v2-quote cite {
        display: block;
        font-style: normal;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.7rem;
        color: #E07840;
        font-weight: 600;
      }

      .v2-hero-right {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* ===== STATS BAR ===== */
      .v2-stats-bar {
        background: #0d1e30;
        padding: 2.5rem 0;
      }

      .v2-stats-grid {
        display: flex;
        justify-content: center;
        gap: clamp(3rem, 8vw, 6rem);
        text-align: center;
      }

      .v2-stat-number {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 3.5rem;
        font-weight: 700;
        background: linear-gradient(135deg, #D4622E, #E07840);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
        margin-bottom: 0.5rem;
      }

      .v2-stat-label {
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        font-weight: 600;
      }

      /* ===== PATOLOGIE ===== */
      .v2-patologie-section {
        background: #F7F3EC;
        padding: clamp(3rem, 6vw, 4.5rem) 0;
      }

      .v2-patologie-group + .v2-patologie-group {
        margin-top: clamp(2.5rem, 5vw, 4rem);
      }

      .v2-section-header h2 {
        font-family: 'Playfair Display', Georgia, serif;
        color: #15293F;
        font-size: 2rem;
        margin-bottom: 0.5rem;
      }

      .v2-section-header p {
        color: #6B7280;
        font-size: 0.98rem;
        max-width: 560px;
      }

      .v2-divider {
        width: 48px;
        height: 3px;
        background: #D4622E;
        margin-top: 0.8rem;
        margin-bottom: 2rem;
        border-radius: 2px;
      }

      .v2-cards-anca {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.75rem;
      }

      .v2-cards-ginocchio {
        display: grid;
        justify-content: center;
      }

      .v2-cards-ginocchio .v2-card {
        max-width: 480px;
      }

      .v2-card {
        background: #FFFFFF;
        border: 1px solid #E8E2D8;
        border-radius: 8px;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
      }

      .v2-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(21, 41, 63, 0.1);
        border-color: #D4622E;
      }

      .v2-card-media {
        height: 200px;
        width: 100%;
        background: #EEE8DF;
      }

      .v2-card-media svg {
        width: 100%;
        height: 100%;
        display: block;
      }

      .v2-card-body {
        padding: 1.5rem;
      }

      .v2-badge {
        display: inline-block;
        background: #E8F4F2;
        color: #D4622E;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.25rem 0.7rem;
        border-radius: 100px;
      }

      .v2-card h3 {
        font-family: 'Playfair Display', Georgia, serif;
        color: #15293F;
        font-size: 1.15rem;
        margin-top: 0.6rem;
        line-height: 1.35;
      }

      .v2-card p {
        color: #4A5568;
        font-size: 0.88rem;
        line-height: 1.7;
        margin-top: 0.6rem;
      }

      .v2-card-link {
        display: block;
        color: #D4622E;
        font-weight: 600;
        font-size: 0.9rem;
        margin-top: 1rem;
        text-decoration: none;
      }

      /* ===== BIO STRIP ===== */
      .v2-bio-strip {
        background: linear-gradient(145deg, #15293F 0%, #1a3a5c 100%);
        padding: clamp(3rem, 6vw, 4.5rem) 0;
      }

      .v2-bio-inner {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
      }

      .v2-bio-left h2 {
        font-family: 'Playfair Display', Georgia, serif;
        color: #FFFFFF;
        font-size: 1.9rem;
        margin-bottom: 1.1rem;
      }

      .v2-bio-left p {
        color: rgba(255, 255, 255, 0.72);
        line-height: 1.8;
        margin-bottom: 1.6rem;
      }

      .v2-bio-right {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
      }

      .v2-bio-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }

      .v2-bio-stat {
        text-align: center;
      }

      .v2-bio-stat .v2-stat-number {
        font-size: 2.2rem;
        margin-bottom: 0.3rem;
      }

      .v2-bio-stat .v2-stat-label {
        font-size: 0.65rem;
      }

      .v2-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .v2-badge-item {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: rgba(255, 255, 255, 0.8);
        padding: 0.3rem 0.85rem;
        border-radius: 100px;
        font-size: 0.78rem;
      }

      /* ===== ARTICLE / CHI SONO ===== */
      .v2-article-hero {
        background: linear-gradient(145deg, #0a1628 0%, #1a3a5c 100%);
        padding: clamp(3rem, 6vw, 4.5rem) 0;
      }

      .v2-article-hero h1 {
        font-family: 'Playfair Display', Georgia, serif;
        color: #FFFFFF;
        font-size: clamp(2rem, 4vw, 2.7rem);
        line-height: 1.15;
        margin-bottom: 1rem;
      }

      .v2-article-hero .v2-lead {
        color: rgba(255, 255, 255, 0.72);
        font-size: 1.05rem;
        line-height: 1.7;
        max-width: 680px;
      }

      .v2-article-body {
        background: #F7F3EC;
        padding: clamp(2.5rem, 5vw, 4rem) 0;
      }

      .v2-article-content {
        max-width: 740px;
      }

      .v2-article-content h2 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.5rem;
        color: #15293F;
        margin: 2.5rem 0 0.8rem;
        font-weight: 600;
      }

      .v2-article-content h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.2rem;
        color: #15293F;
        margin: 1.8rem 0 0.6rem;
      }

      .v2-article-content p {
        margin-bottom: 1.2rem;
        color: #3A3A3A;
        line-height: 1.8;
      }

      .v2-article-content ul,
      .v2-article-content ol {
        margin: 0.8rem 0 1.2rem 1.5rem;
      }

      .v2-article-content li {
        margin-bottom: 0.4rem;
        line-height: 1.7;
        color: #3A3A3A;
      }

      .v2-article-content strong { color: #15293F; }

      .v2-article-content a { color: #D4622E; }

      .v2-article-content img {
        max-width: 100%;
        height: auto;
        border-radius: 6px;
        margin: 1.5rem 0;
        display: block;
        box-shadow: 0 2px 12px rgba(21, 41, 63, 0.1);
      }

      .v2-article-content img + em {
        display: block;
        font-size: 0.82rem;
        color: #6B7280;
        margin-top: -1rem;
        margin-bottom: 1.5rem;
        font-style: italic;
      }

      .v2-article-cta-box {
        background: #FFFFFF;
        border: 1px solid #E8E2D8;
        border-left: 4px solid #D4622E;
        border-radius: 8px;
        padding: 2rem;
        margin-top: 3rem;
      }

      .v2-article-cta-box h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.2rem;
        color: #15293F;
        margin-bottom: 0.6rem;
      }

      .v2-article-cta-box p {
        font-size: 0.92rem;
        color: #6B7280;
        margin-bottom: 1.2rem;
      }

      .v2-chi-sono-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 4rem;
        align-items: start;
      }

      .v2-chi-sono-photo {
        max-width: 280px;
        width: 100%;
        border-radius: 6px;
        margin-bottom: 2rem;
        display: block;
        box-shadow: 0 8px 24px rgba(21, 41, 63, 0.12);
      }

      .v2-sidebar-card {
        background: #FFFFFF;
        border: 1px solid #E8E2D8;
        border-radius: 8px;
        padding: 1.8rem;
        position: sticky;
        top: 2rem;
      }

      .v2-sidebar-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #D4622E;
        font-weight: 700;
        margin-bottom: 1rem;
      }

      .v2-sidebar-card p.v2-sidebar-name {
        font-weight: 700;
        color: #15293F;
        margin-bottom: 0.3rem;
      }

      .v2-sidebar-card p.v2-sidebar-city {
        font-size: 0.88rem;
        color: #6B7280;
        margin-bottom: 1.5rem;
      }

      .v2-sidebar-divider {
        border: none;
        border-top: 1px solid #E8E2D8;
        margin: 1.5rem 0;
      }

      .v2-sidebar-memberships {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .v2-sidebar-memberships span {
        font-size: 0.82rem;
        color: #15293F;
      }

      @media (max-width: 860px) {
        .v2-hero-inner { grid-template-columns: 1fr; }
        .v2-hero-right { order: -1; max-width: 260px; margin: 0 auto; }
        .v2-hero-left h1 { font-size: 2.6rem; }
        .v2-stats-grid { flex-direction: column; gap: 1.75rem; }
        .v2-cards-anca { grid-template-columns: 1fr; }
        .v2-bio-inner { grid-template-columns: 1fr; }
        .v2-bio-stats { gap: 0.75rem; }
        .v2-chi-sono-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
